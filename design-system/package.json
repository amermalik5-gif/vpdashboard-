{
  "name": "nwc-design-system",
  "version": "1.0.0",
  "private": true,
  "description": "NWC design system: tokens, fonts, logos, Tailwind preset, components and rules shared by NWC websites. Private: the Neo Sans fonts are licensed.",
  "type": "module",
  "scripts": {
    "dev": "vite dev --config dev/vite.config.ts",
    "build": "tsc -p dev/tsconfig.json && vite build --config dev/vite.config.ts",
    "test": "playwright test --config dev/playwright.config.ts",
    "reference": "playwright test --config dev/playwright.config.ts --update-snapshots",
    "new-site": "node tools/ds.mjs new-site"
  },
  "peerDependencies": {
    "@fontsource/inter": "^5.0.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^1.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.57.0",
    "postcss": "^8.5.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "5.7",
    "vite": "^6.4.4"
  }
}
